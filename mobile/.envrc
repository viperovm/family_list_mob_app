# Android SDK / JDK environment for this project.
# Source this file with: source .envrc (or copy into your shell profile).
export JAVA_HOME=/usr/local/opt/openjdk@17
export ANDROID_HOME=/Users/admin/Projects/lists_app/.android-tools/sdk
export ANDROID_SDK_ROOT="$ANDROID_HOME"
export PATH="$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools:$ANDROID_HOME/emulator:$PATH"

# Backend API base URL reachable from the Android emulator (host loopback = 10.0.2.2)
export EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1