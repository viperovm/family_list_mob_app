{
  "expo": {
    "name": "Семейные списки",
    "slug": "family-shopping-lists",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "familylists",
    "extra": {
      "eas": {
        "projectId": "12da92bb-1d56-4cf5-8ffb-ed9561d173e6"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#2563EB",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Доступ к контактам нужен, чтобы находить близких по имени и показывать, кто вас пригласил."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.familylists.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "googleServicesFile": "./google-services.json",
      "package": "com.familylists.app",
      "permissions": [
        "android.permission.READ_PHONE_STATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
