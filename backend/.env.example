# --- Django ---
SECRET_KEY=change-me-in-production
DEBUG=true
ALLOWED_HOSTS=*
DJANGO_SETTINGS_MODULE=config.settings

# --- Database (PostgreSQL) ---
# НАТИВНЫЙ запуск (без Docker): хост 127.0.0.1.
# (Если БД/Redis в Docker — используйте имена контейнеров `db` и `redis`.)
DATABASE_URL=postgres://lists:lists@127.0.0.1:5432/lists

# --- Redis / Celery ---
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_TASK_ALWAYS_EAGER=false

# --- Email ---
# Production (Mail.ru). Пароль приложения генерируется в настройках Mail.ru
# («Настройки» → «Пароли для внешних приложений»). Не храните .env в git.
EMAIL_BACKEND_URL=smtp://family_mob_app@mail.ru:APP_PASSWORD@smtp.mail.ru:465/?ssl=true
DEFAULT_FROM_EMAIL=Семейные списки <family_mob_app@mail.ru>

# --- Auth / product flags ---
PHONE_LOGIN_ENABLED=true
REQUIRE_EMAIL_CODE_FOR_NEW_DEVICE=false
RU_PHONE_ONLY=true

# --- Email code settings ---
EMAIL_CODE_TTL_SECONDS=600
EMAIL_CODE_LENGTH=6
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_RESEND_COOLDOWN_SECONDS=60
PHONE_CHANGE_MAX_ATTEMPTS_PER_DAY=3

# --- Push (Expo Push API) ---
# Токен доступа создаётся на https://expo.dev/accounts/[account]/settings/access-tokens
# Пусто = dev-режим: уведомления не отправляются, а логируются.
EXPO_ACCESS_TOKEN=

# --- CORS ---
CORS_ALLOWED_ORIGINS=
